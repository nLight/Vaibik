#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		zephyr,console = &uart0;
	};

	buttons {
		compatible = "gpio-keys";

		ptt_input: ptt-input {
			gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};
};

&pinctrl {
	vibemic_pdm_default: vibemic_pdm_default {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 0, 17)>,
				<NRF_PSEL(PDM_DIN, 0, 20)>;
		};
	};

	vibemic_pdm_sleep: vibemic_pdm_sleep {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 0, 17)>,
				<NRF_PSEL(PDM_DIN, 0, 20)>;
			low-power-enable;
		};
	};
};

&pdm0 {
	status = "okay";
	pinctrl-0 = <&vibemic_pdm_default>;
	pinctrl-1 = <&vibemic_pdm_sleep>;
	pinctrl-names = "default", "sleep";
	clock-source = "PCLK32M_HFXO";
};

&board_cdc_acm_uart {
	status = "disabled";
};
