{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeMic",
  "version": "0.1.35",
  "identifier": "dev.vibemic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeMic",
        "width": 780,
        "height": 620,
        "minWidth": 640,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 32.5 },
        "backgroundColor": "#e4e3de",
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/desktop-resources/": "vibemic/"
    },
    "category": "DeveloperTool",
    "shortDescription": "Push-to-talk voice console for Codex and Claude Code",
    "longDescription": "VibeMic is the desktop companion for the Vaibik push-to-talk microphone: local Parakeet transcription, agent terminal and firmware flashing.",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "../assets/entitlements.mac.plist",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libudev1", "libasound2"],
        "files": {
          "/usr/lib/udev/rules.d/70-vibemic.rules": "../assets/70-vibemic.rules"
        }
      }
    }
  }
}